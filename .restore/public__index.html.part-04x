.gate .card,dialog{background:var(--card);border:1px solid var(--line);color:var(--ink)}
dialog::backdrop{background:rgba(0,0,0,.55)}
.notice{background:var(--pink-t);color:#f39abb}
.ob-prog{background:var(--line)}
.ob-art{background:var(--pink-t);color:#f39abb}
.big-code{background:var(--panel2);border:1px dashed #4b4450;box-shadow:none}
.added li{background:var(--card);border:1px solid var(--line);box-shadow:none}
.quick button{background:var(--panel2);border:1px solid var(--line);color:var(--ink)}
.quick button[aria-pressed="true"]{background:var(--pink-t);color:#f39abb;border-color:#5b3447}
.legal a{color:var(--soft)}
.legal.credit a{color:var(--pink)}

.grid2{grid-template-columns:minmax(0,1fr)}
@media (min-width:900px){.grid2{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
.blk{min-width:0}
.home-main{min-width:0}
@media (min-width:900px){.home-grid{grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr)}}
.btnrow:has(> [hidden]){grid-template-columns:1fr}
.burrow .week{gap:4px}
.burrow .week i{width:24px;height:24px}
.due-row:has(+ .due-foot),.due-row:has(+ .due-row:last-child)~.due-row{border-bottom:0}
.due-row:has(+ .due-foot){border-bottom:0}
</style>
</head>
<body>
<div class="app">

  <div id="scr-loading" class="loading"><div class="boot">
    <img src="/icon-192.png" alt="Loading Honeybun">
    <div id="bootMsg" hidden><b>Honeybun is getting a fresh update…</b><span>Hang tight, refreshing in a few seconds 🐰</span></div>
    <button class="go" id="bootBtn" hidden>Refresh</button>
  </div></div>

  <!-- LOGIN / SIGN UP / FORGOT -->
  <main id="scr-auth" class="gate" hidden>
    <img class="logo" src="/icon-192.png" alt="">
    <h1>Honeybun</h1>
    <p class="tag">A cute little budget for you and yours</p>
    <div class="notice" id="inviteNotice" hidden>You've been invited to a budget. Log in or create an account to join.</div>
    <div class="card" id="authCard">
      <div class="tabs" role="tablist" aria-label="Account">
        <button role="tab" data-auth="signup" aria-selected="true">Create account</button>
        <button role="tab" data-auth="login" aria-selected="false">Log in</button>
      </div>
      <form id="authForm" novalidate>
        <div class="field" id="nameField"><label for="aName">Your name</label><input id="aName" autocomplete="given-name" maxlength="24"></div>
        <div class="field"><label for="aEmail">Email</label><input id="aEmail" type="email" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false"></div>
        <div class="field"><label for="aPass">Password</label><input id="aPass" type="password" autocomplete="new-password" minlength="8" placeholder="At least 8 characters"></div>
        <button class="go" id="authBtn" type="submit">Create account</button>
        <p class="err" id="authErr" role="alert"></p>
        <p class="center" id="forgotWrap" hidden><button type="button" class="linkbtn" id="forgotLink">Forgot your password?</button></p>
      </form>
    </div>
    <div class="card" id="forgotCard" hidden>
      <h2>Reset your password</h2>
      <p class="sub">We'll email you a link to choose a new one.</p>
      <form id="forgotForm" novalidate>
        <div class="field"><label for="fEmail">Email</label><input id="fEmail" type="email" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false"></div>
        <button class="go" id="forgotBtn" type="submit">Send reset link</button>
        <p class="err" id="forgotMsg" role="status"></p>
        <p class="center"><button type="button" class="linkbtn" id="backToLogin">Back to log in</button></p>
      </form>
    </div>
    <div class="lang-row" data-lang-picker></div>
    <p class="legal">By continuing you agree to the <a href="/terms.html">Terms</a> and <a href="/privacy.html">Privacy Policy</a>.</p>
    <p class="legal credit">Developed by Rodrigo · Questions? <a href="mailto:help@honeybun.me">help@honeybun.me</a></p>
  </main>

  <!-- NEW PASSWORD -->
  <main id="scr-reset" class="gate" hidden>
    <img class="logo" src="/icon-192.png" alt="">
    <h1>New password</h1>
    <p class="tag">Choose a new password for Honeybun.</p>
    <div class="card">
      <form id="resetForm" novalidate>
        <div class="field"><label for="rPass">New password</label><input id="rPass" type="password" autocomplete="new-password" placeholder="At least 8 characters"></div>
        <div class="field"><label for="rPass2">Type it again</label><input id="rPass2" type="password" autocomplete="new-password"></div>
        <button class="go" id="resetBtn" type="submit">Save new password</button>
        <p class="err" id="resetErr" role="alert"></p>
      </form>
    </div>
  </main>

  <!-- EMAIL CONFIRMED -->
  <main id="scr-verify" class="gate" hidden>
    <img class="logo" src="/icon-192.png" alt="">
    <h1 id="verifyTitle">Confirming…</h1>
    <p class="tag" id="verifyText"></p>
    <button class="go" id="verifyGo" hidden>Open Honeybun</button>
  </main>

  <!-- START OR JOIN -->
  <main id="scr-setup" class="gate" hidden>
    <img class="logo" src="/icon-192.png" alt="">
    <h1 id="setupHi">Hi!</h1>
    <p class="tag">Start a budget, or join your partner's.</p>
    <div class="card">
      <h2>Start a new budget</h2>
      <p class="sub">Who's this budget for?</p>
      <div class="kinds" id="kinds">
        <button type="button" data-kind="solo" aria-pressed="false"><b>🐰</b>Just me</button>
        <button type="button" data-kind="couple" aria-pressed="true"><b>🐰🐻</b>Couple</button>
        <button type="button" data-kind="family" aria-pressed="false"><b>🐰🐻🐥</b>Family</button>
      </div>
      <div class="field"><label for="newNestName">Budget name (optional)</label><input id="newNestName" maxlength="24" placeholder="Our little home"></div>
      <button class="go" id="createNest">Start our budget</button>
    </div>
    <div class="or">or</div>
    <div class="card">
      <h2>Join with a code</h2>
      <p class="sub">Got an invite code or link from someone? Use it here.</p>
      <div class="field"><label for="joinCode">Invite code</label><input id="joinCode" maxlength="12" autocapitalize="characters" autocomplete="off" spellcheck="false" placeholder="ABCD-EFGH"></div>
      <button class="go inc" id="joinNest">Join budget</button>
    </div>
    <p class="err" id="setupErr" role="alert"></p>
    <p class="center"><button class="linkbtn" id="setupLogout">Log out</button></p>
  </main>

  <!-- FIRST-TIME SETUP (invite → paydays → bills) -->
  <main id="scr-onboard" class="ob" hidden>
    <div class="ob-top">
      <button id="obBack">Back</button>
      <div class="ob-prog"><i id="obProg"></i></div>
      <button id="obSkip">Skip</button>
    </div>
    <div id="obBody"></div>
    <div class="ob-foot">
      <p class="err" id="obErr" role="alert"></p>
      <button class="go" id="obNext">Next</button>
    </div>
  </main>

  <div class="offline-bar" id="offlineBar" hidden>You're offline. Changes will sync when you're back.</div>
  <header class="top" id="topBar" hidden>
    <button class="hello hi-btn" id="hiBtn" aria-label="Open settings">
      <span class="avs" id="hdrAvs"></span>
      <span class="hello-txt"><small id="greet">Hi</small><span id="hi" class="h1">Us</span></span>
    </button>
    <button class="iconbtn" id="helpBtn" aria-label="Help"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .9-1 1.6v.4M12 17h.01"/></svg></button>
    <button class="iconbtn" id="setBtn" aria-label="Settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg></button>
    <button class="inbox-btn iconbtn" id="inboxBtn" aria-label="Messages from Bun">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 7 0 1 1 3.6 5.8L4 19.5l1.2-3.4A6.7 6.7 0 0 1 4 12z"/><circle cx="9" cy="12" r=".9" fill="currentColor"/><circle cx="12" cy="12" r=".9" fill="currentColor"/><circle cx="15" cy="12" r=".9" fill="currentColor"/></svg>
      <span class="badge-dot" id="inboxBadge" hidden></span>
    </button>
    <div class="month" aria-label="Choose month" id="monthNav">
      <button id="prevM" aria-label="Previous month">‹</button>
      <span id="monthLbl"></span>
      <button id="nextM" aria-label="Next month">›</button>
    </div>
  </header>

  <!-- HOME -->
  <main id="scr-home" hidden>
<div class="home-grid"><div class="home-main">
    <section class="hero" aria-label="This month's money">
      <div class="ears" aria-hidden="true"><i></i><i></i></div>
      <div class="hero-row">
        <span class="hero-lbl"><span id="leftLbl">Left in</span><button class="mo" id="heroPrev" aria-label="Previous month">‹</button><b id="heroMonth"></b><button class="mo" id="heroNext" aria-label="Next month">›</button></span>
        <span class="chip" id="heroChip" hidden></span>
      </div>
      <div class="left-amt" id="leftAmt">$0.00</div>
      <div class="meter" aria-hidden="true"><i id="meter" style="width:0"></i></div>
      <div class="hero-stats">
        <div><span>Came in</span><b class="in" id="flowIn"></b></div>
        <div><span>Spent</span><b id="flowOut"></b></div>
        <div><span>Bills due</span><b id="billsDue"></b></div>
      </div>
    </section>

    <button class="bun-note" id="bunNote" aria-label="Messages from Bun">
      <svg class="bunny" id="bunny" viewBox="0 0 120 128" aria-hidden="true">
        <g class="body" fill="#FFFFFF" stroke="#2F2A36" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M44 54 C33 30 34 7 42 6 C50 5 54 28 55 48"/>
          <path d="M76 54 C87 30 86 7 78 6 C70 5 66 28 65 48"/>
          <ellipse cx="60" cy="84" rx="38" ry="34"/>
          <circle cx="47" cy="81" r="4.5" fill="#2F2A36" stroke="none"/><circle cx="73" cy="81" r="4.5" fill="#2F2A36" stroke="none"/>
          <ellipse cx="36" cy="93" rx="7" ry="4" fill="#F6B8CB" stroke="none"/><ellipse cx="84" cy="93" rx="7" ry="4" fill="#F6B8CB" stroke="none"/>
          <path id="mouth" d="M53 92 q3.5 4 7 0 q3.5 4 7 0" fill="none" stroke-width="4"/>
          <g id="prop"></g>
          <g id="gear"></g>
        </g>
      </svg>
      <span class="bubble" id="bubble"></span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg>
    </button>

    <div class="verify-banner" id="verifyBanner" hidden><span>Please confirm your email</span><button class="mini" id="resendVerify">Resend</button><button class="vb-x" id="hideVerify" aria-label="Hide for now">✕</button></div>
    <div class="tiles2">
      <button class="tile2" id="streakTile" aria-label="Hop streak"></button>
      <button class="tile2" id="levelTile" aria-label="Level"></button>
    </div>
    <button class="burrow-pill" id="burrowPill" hidden></button>
  </div>
  <aside class="due side" id="dueCard" aria-label="Coming up"></aside>
</div>
    <div id="homeBud"></div>

    <div class="couple" id="couple"></div>
    <div class="filter-note" id="filterNote" hidden></div>
    <div class="section-h"><h2>Latest</h2><button class="linkbtn" id="seeAll">See all</button></div>
    <div class="panel"><ul class="list" id="recent"></ul></div>
  </main>

  <!-- BUN'S INBOX -->
  <main id="scr-inbox" hidden>
    <div class="chat-head">
      <button class="chat-back" id="inboxBack" aria-label="Back">‹</button>
      <div class="chat-av"><img src="/icon-192.png" alt=""></div>
      <div class="chat-who"><b>Bun</b><small>Your budget buddy 🐰</small></div>
    </div>
    <div class="chat" id="chat" aria-live="polite" data-nt></div>
    <div class="quick-replies"><button id="qrDue">What's due?</button><button id="qrStreak">My streak</button><button id="qrAdd">Add spend</button></div>
  </main>

  <!-- PLAN -->
  <main id="scr-plan" hidden>
    <div class="pagehead"><div><h1>Plan</h1><p>Everything upcoming, without the clutter.</p></div><div class="ph-slot"></div></div>
    <div class="grid2">
      <div class="blk">
        <div class="section-h" style="margin-top:0"><h2>Budget</h2><button class="linkbtn" id="editBudgets">Edit</button></div>
        <div class="panel pad" id="budgets"></div>
      </div>
      <div class="blk">
        <div class="section-h" id="billsH" style="margin-top:0"><h2>Calendar</h2><button class="linkbtn" id="addBill">Add bill or payday</button></div>
        <div class="panel pad">
          <div class="cal" id="cal"></div>
          <div class="cal-day" id="calDay"></div>
        </div>
      </div>
      <div class="blk">
        <div class="section-h"><h2>Honey jars</h2><button class="linkbtn" id="addGoal">New jar</button></div>
        <div id="goals"></div>
      </div>
      <div class="blk">
        <div class="section-h"><h2>Bills &amp; paydays</h2></div>
        <div class="panel"><ul class="list" id="bills"></ul></div>
      </div>
      <div class="blk">
        <div class="section-h"><h2>Debts</h2><button class="linkbtn" id="addDebt">Add debt</button></div>
        <div class="panel pad" id="debts"></div>
      </div>
    </div>
  </main>

  <!-- ADD / EDIT -->
  <main id="scr-add" hidden>
    <div class="edit-bar" id="editBar" hidden>
      <h2 id="editTitle">Edit</h2>
      <button class="linkbtn" id="cancelEdit">Cancel</button>
    </div>
    <div class="tabs" role="tablist" aria-label="Type">
      <button role="tab" data-t="expense" aria-selected="true">Spent</button>
      <button role="tab" data-t="income" aria-selected="false">Got paid</button>
    </div>
    <div class="add-bun" aria-hidden="true"><svg viewBox="0 0 120 128"><g fill="#FFFFFF" stroke="#2F2A36" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><path d="M44 54 C33 30 34 7 42 6 C50 5 54 28 55 48"/><path d="M76 54 C87 30 86 7 78 6 C70 5 66 28 65 48"/><ellipse cx="60" cy="84" rx="38" ry="34"/></g><circle cx="47" cy="81" r="4.5" fill="#2F2A36"/><circle cx="73" cy="81" r="4.5" fill="#2F2A36"/><ellipse cx="36" cy="93" rx="7" ry="4" fill="#F6B8CB"/><ellipse cx="84" cy="93" rx="7" ry="4" fill="#F6B8CB"/><path d="M53 92 q3.5 4 7 0 q3.5 4 7 0" fill="none" stroke="#2F2A36" stroke-width="4" stroke-linecap="round"/></svg></div>
    <label class="bigamt" for="amt"><span>$</span><input id="amt" type="number" inputmode="decimal" min="0" step="0.01" placeholder="0" aria-label="Amount"></label>
    <div class="field" id="catField"><span class="lbl">What for?</span><div class="cats" id="cats"></div></div>
    <div class="field"><label for="lbl" id="lblLabel">Note (optional)</label><input id="lbl" type="text" maxlength="40" placeholder="Date night tacos"></div>
    <div class="field"><span class="lbl" id="whoLabel">Who paid?</span><div class="whos" id="whos"></div></div>
    <div class="field" id="splitField"><span class="lbl">Split</span>
      <div class="split"><button type="button" id="spShared" aria-pressed="true">Split it</button><button type="button" id="spMine" aria-pressed="false">Just mine</button></div>
      <div id="splitOpts">
        <div class="sub-opts" id="splitModes">
          <button type="button" data-mode="equal">Evenly</button>
          <button type="button" data-mode="percent">By %</button>
          <button type="button" data-mode="owed">Set amount owed</button>
        </div>
        <div class="split-val" id="splitValWrap" hidden><span id="splitPre"></span><input id="splitVal" type="number" inputmode="decimal" min="0" step="1"><span id="splitPost"></span></div>
        <p class="hint" id="splitHint"></p>
      </div>
    </div>
    <label class="check" id="privWrap"><input type="checkbox" id="priv"> Only I can see this</label>
    <div class="field" id="repeatField"><label for="repeat">Repeats</label>
      <select id="repeat">
        <option value="">Doesn't repeat</option>
        <option value="weekly">Every week</option>
        <option value="biweekly">Every 2 weeks</option>
        <option value="monthly">Every month</option>
      </select>
    </div>
    <div class="field"><label for="dt" id="dtLabel">Date</label><input id="dt" type="date"></div>
    <label class="check" id="paidNowWrap" hidden><input type="checkbox" id="paidNow"> <span id="paidNowTxt">Already paid this one</span></label>
    <button class="go" id="goBtn">Add expense</button>
    <p class="err" id="err" role="status"></p>
    <p class="center" id="delRecWrap" hidden><button class="linkbtn danger" id="delRec">Delete this repeating item</button></p>
  </main>

  <!-- STATS -->
  <main id="scr-stats" hidden>
    <div class="pagehead"><div><h1>Stats</h1><p>A quick read on how you're doing.</p></div></div>
    <div class="grid2">
      <div class="blk">
        <section class="burrow" id="burrow" aria-label="Your progress"></section>
        <div class="kpis" id="kpis"></div>
        <div class="section-h" id="badgesH"><h2>Badges</h2><span class="sub" id="badgeCount"></span></div>
        <div class="panel pad"><div class="badges" id="badges"></div></div>
        <div id="boardWrap"><div class="section-h"><h2>This week's carrots</h2></div>
        <div class="panel pad" id="board"></div></div>
      </div>
      <div class="blk">
