const E = (s) => new TextEncoder().encode(s);
const now = () => Math.floor(Date.now() / 1000);
const clean = (s, n) => String(s || "").trim().replace(/\s+/g, " ").slice(0, n);
const email = (s) => clean(s, 200).toLowerCase();
const money = (n) => Math.round(Number(n) * 100);
const okEmail = (s) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s);
const uuid = () => crypto.randomUUID();
const addDaysS = (s, n) => { const d = new Date(s + "T12:00:00Z"); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); };
const dayDiff = (a, b) => Math.round((new Date(a + "T12:00:00Z") - new Date(b + "T12:00:00Z")) / 86400000);
const thisMonday = (s) => { const d = new Date(s + "T12:00:00Z"), n = (d.getUTCDay() + 6) % 7; d.setUTCDate(d.getUTCDate() - n); return d.toISOString().slice(0, 10); };

const json = (data, status = 200, headers = {}) => new Response(JSON.stringify(data), { status, headers: { "content-type": "application/json; charset=utf-8", ...headers } });
const err = (error, status = 400) => json({ error }, status);
const readJson = async (req) => { try { return await req.json(); } catch { return {}; } };

async function hashText(s) {
  const b = await crypto.subtle.digest("SHA-256", E(s));
  return [...new Uint8Array(b)].map((x) => x.toString(16).padStart(2, "0")).join("");
}
async function pbkdf2(password, saltB64) {
  const salt = Uint8Array.from(atob(saltB64), (c) => c.charCodeAt(0));
  const key = await crypto.subtle.importKey("raw", E(password), "PBKDF2", false, ["deriveBits"]);
  const bits = await crypto.subtle.deriveBits({ name: "PBKDF2", salt, iterations: 150000, hash: "SHA-256" }, key, 256);
  return btoa(String.fromCharCode(...new Uint8Array(bits)));
}
function salt() { const b = crypto.getRandomValues(new Uint8Array(16)); return btoa(String.fromCharCode(...b)); }
async function makePass(pw) { const s = salt(); return { salt: s, hash: await pbkdf2(pw, s) }; }
async function checkPass(pw, s, hash) { return (await pbkdf2(pw, s)) === hash; }
async function tokenHash(t) { return hashText(t); }
function token() { const b = crypto.getRandomValues(new Uint8Array(32)); return btoa(String.fromCharCode(...b)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, ""); }

function cookie(name, value, maxAge = 60 * 60 * 24 * 30) {
  return `${name}=${value}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=${maxAge}`;
}
function getCookie(req, name) {
  const c = req.headers.get("cookie") || "";
  for (const p of c.split(";")) { const [k, ...v] = p.trim().split("="); if (k === name) return v.join("="); }
  return null;
}
async function auth(req, env) {
  const raw = getCookie(req, "hb_session"); if (!raw) return null;
  const h = await tokenHash(raw);
  const row = await env.DB.prepare(`SELECT u.* FROM sessions s JOIN users u ON u.id=s.user_id WHERE s.token_hash=? AND s.expires_at>?`).bind(h, now()).first();
  return row || null;
}
async function makeSession(userId, env) {
  const t = token(), h = await tokenHash(t), exp = now() + 60 * 60 * 24 * 30;
  await env.DB.prepare(`INSERT INTO sessions(token_hash,user_id,expires_at,created_at) VALUES(?,?,?,?)`).bind(h, userId, exp, now()).run();
  return { token: t, expires_at: exp };
}
async function clearSession(req, env) {
  const raw = getCookie(req, "hb_session");
  if (raw) await env.DB.prepare(`DELETE FROM sessions WHERE token_hash=?`).bind(await tokenHash(raw)).run();
}

async function rate(env, key, limit, seconds) {
  const t = now();
  await env.DB.prepare(`DELETE FROM rate_limits WHERE expires_at<?`).bind(t - 60).run().catch(() => {});
  const r = await env.DB.prepare(`SELECT count,expires_at FROM rate_limits WHERE key=?`).bind(key).first();
  if (!r || r.expires_at <= t) {
    await env.DB.prepare(`INSERT INTO rate_limits(key,count,expires_at) VALUES(?,?,?) ON CONFLICT(key) DO UPDATE SET count=excluded.count,expires_at=excluded.expires_at`).bind(key, 1, t + seconds).run();
    return true;
  }
  if (r.count >= limit) return false;
  await env.DB.prepare(`UPDATE rate_limits SET count=count+1 WHERE key=?`).bind(key).run();
  return true;
}
const ipKey = (req) => req.headers.get("CF-Connecting-IP") || "x";

async function sendMail(env, to, subject, html) {
  if (!env.RESEND_API_KEY) throw new Error("email-not-configured");
  const from = env.MAIL_FROM || "Honeybun <hello@honeybun.me>";
  const r = await fetch("https://api.resend.com/emails", { method: "POST", headers: { "authorization": `Bearer ${env.RESEND_API_KEY}`, "content-type": "application/json" }, body: JSON.stringify({ from, to, subject, html }) });
  if (!r.ok) throw new Error("email-send-failed");
}

const CATS = new Set(["home","groc","food","date","bills","subs","car","fun","pets","debt","other"]);
const FREQ = new Set(["weekly","biweekly","monthly"]);
const SPLIT = new Set(["equal","percent","owed"]);
const KINDS = new Set(["solo","couple","family"]);
const ACCENTS = new Set(["blueberry","blush","lavender","honey"]);
const LANGS = new Set(["en","es","zh"]);
const levelFor = (xp) => { let l = 1; while (xp >= 25 * (l + 1) * l) l++; return l; };
const rewardBase = { entry: 2, recurring: 3, settlement: 2, jar: 3, debt: 3, setup: 5 };
async function reward(env, user, kind, date) {
  const gain = rewardBase[kind] || 1, before = levelFor(user.xp || 0);
  let streak = user.streak || 0, best = user.best_streak || 0, last = user.last_day || null, streakUp = false, firstToday = false;
  if (date) {
    if (last !== date) {
      firstToday = true;
      const yd = addDaysS(date, -1);
      streak = last === yd ? streak + 1 : 1;
      streakUp = streak > 1;
      if (streak > best) best = streak;
      last = date;
    }
  }
  const xp = (user.xp || 0) + gain, after = levelFor(xp), wk = date ? thisMonday(date) : user.week_key;
  const wxp = user.week_key === wk ? (user.week_xp || 0) + gain : gain;
  const logs = (user.logs || 0) + 1;
  await env.DB.prepare(`UPDATE users SET xp=?,streak=?,best_streak=?,last_day=?,week_key=?,week_xp=?,logs=?,updated_at=? WHERE id=?`).bind(xp, streak, best, last, wk, wxp, logs, now(), user.id).run();
  Object.assign(user, { xp, streak, best_streak: best, last_day: last, week_key: wk, week_xp: wxp, logs });
  return { gained: gain, xp, streak, best_streak: best, level: after, leveled: after > before, streak_up: streakUp, first_today: firstToday };
}

async function userNest(env, uid) {
  return env.DB.prepare(`SELECT n.* FROM nests n JOIN members m ON m.nest_id=n.id WHERE m.user_id=?`).bind(uid).first();
}
async function members(env, nestId) {
  return env.DB.prepare(`SELECT u.id,u.name,u.email,u.emoji,u.color,u.xp,u.streak,u.best_streak,u.last_day,u.week_key,u.week_xp,u.logs,m.joined_at FROM members m JOIN users u ON u.id=m.user_id WHERE m.nest_id=? ORDER BY m.joined_at,u.id`).bind(nestId).all().then((x) => x.results);
}
async function needNest(env, user) {
  const n = await userNest(env, user.id); if (!n) throw Object.assign(new Error("no-nest"), { status: 404 }); return n;
}

function entryOwed(e, count) {
  if (!e.shared || count < 2) return 0;
  const a = e.amount_cents;
  if (e.split_mode === "percent") return Math.round(a * (100 - e.split_value) / 100);
  if (e.split_mode === "owed") return Math.max(0, Math.min(a, e.split_value));
  return Math.round(a * (count - 1) / count);
}
async function balances(env, nestId, mems) {
  const out = Object.fromEntries(mems.map((m) => [m.id, 0]));
  const es = await env.DB.prepare(`SELECT * FROM entries WHERE nest_id=? AND type='expense' AND shared=1 AND private=0 ORDER BY date,id`).bind(nestId).all().then((x) => x.results);
  for (const e of es) {
    const pay = e.member_id, owed = entryOwed(e, mems.length);
    const others = mems.filter((m) => m.id !== pay);
    if (!others.length) continue;
    if (e.split_mode === "percent" || e.split_mode === "owed") {
      if (others.length === 1) { out[pay] += owed; out[others[0].id] -= owed; }
      else { const each = Math.floor(owed / others.length); let rem = owed - each * others.length; for (const o of others) { const v = each + (rem-- > 0 ? 1 : 0); out[pay] += v; out[o.id] -= v; } }
    } else {
      const each = Math.floor(e.amount_cents / mems.length); let paidShare = e.amount_cents - each;
      out[pay] += paidShare;
      for (const o of others) out[o.id] -= each;
    }
  }
  const ss = await env.DB.prepare(`SELECT * FROM settlements WHERE nest_id=? ORDER BY date,id`).bind(nestId).all().then((x) => x.results);
  for (const s of ss) { out[s.from_id] += s.amount_cents; out[s.to_id] -= s.amount_cents; }
  return { balances: out, settlements: ss };
}

function occurrences(r, from, to) {
  const out = [], anchor = new Date(r.anchor_date + "T12:00:00Z"), f = new Date(from + "T12:00:00Z"), t = new Date(to + "T12:00:00Z");
  if (r.freq === "monthly") {
    const day = anchor.getUTCDate(); let y = f.getUTCFullYear(), m = f.getUTCMonth();
    for (let i = 0; i < 26; i++) {
      const last = new Date(Date.UTC(y, m + 1, 0)).getUTCDate(), d = new Date(Date.UTC(y, m, Math.min(day, last), 12));
      if (d > t) break; if (d >= f && d >= anchor) out.push(d.toISOString().slice(0,10)); if (++m > 11) { m = 0; y++; }
    }
  } else {
    const step = r.freq === "weekly" ? 7 : 14; let d = new Date(anchor);
    while (d < f) d.setUTCDate(d.getUTCDate() + step);
    for (let i = 0; d <= t && i < 60; i++) { out.push(d.toISOString().slice(0,10)); d.setUTCDate(d.getUTCDate() + step); }
  }
  return out;
}

async function nestPayload(env, user, month) {
  const nest = await needNest(env, user), mems = await members(env, nest.id);
  const es = await env.DB.prepare(`SELECT * FROM entries WHERE nest_id=? AND substr(date,1,7)=? AND (private=0 OR member_id=?) ORDER BY date DESC,id DESC`).bind(nest.id, month, user.id).all().then((x) => x.results);
  const rc = await env.DB.prepare(`SELECT * FROM recurring WHERE nest_id=? ORDER BY type DESC,created_at`).bind(nest.id).all().then((x) => x.results);
  const from = month + "-01", to = month + "-31";
  const lg = await env.DB.prepare(`SELECT recurring_id,occ_date FROM recurring_log WHERE nest_id=? AND occ_date BETWEEN ? AND ?`).bind(nest.id, from, to).all().then((x) => x.results);
  const gs = await env.DB.prepare(`SELECT * FROM goals WHERE nest_id=? ORDER BY created_at,id`).bind(nest.id).all().then((x) => x.results);
  const jars = await env.DB.prepare(`SELECT * FROM jar_moves WHERE nest_id=? ORDER BY created_at DESC,id DESC LIMIT 100`).bind(nest.id).all().then((x) => x.results);
  const buds = await env.DB.prepare(`SELECT * FROM budgets WHERE nest_id=?`).bind(nest.id).all().then((x) => x.results);
  const debts = await env.DB.prepare(`SELECT * FROM debts WHERE nest_id=? ORDER BY created_at,id`).bind(nest.id).all().then((x) => x.results);
  const dp = await env.DB.prepare(`SELECT * FROM debt_payments WHERE nest_id=? ORDER BY date DESC,created_at DESC,id DESC LIMIT 100`).bind(nest.id).all().then((x) => x.results);
  const bal = await balances(env, nest.id, mems);
  const unread = await env.DB.prepare(`SELECT COUNT(*) n FROM inbox WHERE user_id=? AND read_at IS NULL`).bind(user.id).first();
  const latest = await env.DB.prepare(`SELECT id,kind,data,created_at FROM inbox WHERE user_id=? ORDER BY created_at DESC,id DESC LIMIT 1`).bind(user.id).first();
  return { me: safeUser(user), nest, members: mems.map(safeMember), entries: es, recurring: rc, logged: lg, goals: gs, jar: jars, budgets: buds, debts, debt_payments: dp,
    balances: bal.balances, settlements: bal.settlements, setup_done: !!nest.setup_done, inbox: { unread: +(unread?.n || 0), latest: latest ? `${latest.id}|${latest.kind}|${latest.data}` : null } };
}
function safeUser(u) { return { id:u.id,name:u.name,email:u.email,emoji:u.emoji,color:u.color,verified:!!u.verified,xp:u.xp||0,streak:u.streak||0,best_streak:u.best_streak||0,last_day:u.last_day||null,week_key:u.week_key||null,week_xp:u.week_xp||0,logs:u.logs||0,tz:u.tz||null,lang:u.lang||"en",mail:{bills:!!u.mail_bills,streak:!!u.mail_streak,weekly:!!u.mail_weekly} }; }
function safeMember(u) { return { id:u.id,name:u.name,emoji:u.emoji,color:u.color,xp:u.xp||0,streak:u.streak||0,best_streak:u.best_streak||0,last_day:u.last_day||null,week_key:u.week_key||null,week_xp:u.week_xp||0,logs:u.logs||0 }; }

async function setupDb(env) {
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS users(id TEXT PRIMARY KEY,email TEXT UNIQUE NOT NULL,name TEXT NOT NULL,pass_hash TEXT NOT NULL,pass_salt TEXT NOT NULL,emoji TEXT DEFAULT '🐰',color TEXT DEFAULT '#FFD6E5',verified INTEGER DEFAULT 0,xp INTEGER DEFAULT 0,streak INTEGER DEFAULT 0,best_streak INTEGER DEFAULT 0,last_day TEXT,week_key TEXT,week_xp INTEGER DEFAULT 0,logs INTEGER DEFAULT 0,tz TEXT,lang TEXT DEFAULT 'en',mail_bills INTEGER DEFAULT 1,mail_streak INTEGER DEFAULT 1,mail_weekly INTEGER DEFAULT 1,created_at INTEGER,updated_at INTEGER)`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS sessions(token_hash TEXT PRIMARY KEY,user_id TEXT NOT NULL,expires_at INTEGER NOT NULL,created_at INTEGER)`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS nests(id TEXT PRIMARY KEY,name TEXT,kind TEXT DEFAULT 'couple',invite_code TEXT UNIQUE,accent TEXT DEFAULT 'blush',setup_done INTEGER DEFAULT 0,created_at INTEGER,updated_at INTEGER)`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS members(nest_id TEXT NOT NULL,user_id TEXT NOT NULL,joined_at INTEGER,PRIMARY KEY(nest_id,user_id))`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS entries(id TEXT PRIMARY KEY,nest_id TEXT NOT NULL,member_id TEXT NOT NULL,type TEXT NOT NULL,amount_cents INTEGER NOT NULL,label TEXT,category TEXT,shared INTEGER DEFAULT 0,split_mode TEXT,split_value INTEGER,private INTEGER DEFAULT 0,date TEXT NOT NULL,recurring_id TEXT,occ_date TEXT,created_at INTEGER,updated_at INTEGER)`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS settlements(id TEXT PRIMARY KEY,nest_id TEXT NOT NULL,from_id TEXT NOT NULL,to_id TEXT NOT NULL,amount_cents INTEGER NOT NULL,date TEXT NOT NULL,created_at INTEGER)`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS recurring(id TEXT PRIMARY KEY,nest_id TEXT NOT NULL,member_id TEXT NOT NULL,type TEXT NOT NULL,amount_cents INTEGER NOT NULL,label TEXT,category TEXT,shared INTEGER DEFAULT 0,split_mode TEXT,split_value INTEGER,freq TEXT NOT NULL,anchor_date TEXT NOT NULL,created_at INTEGER,updated_at INTEGER)`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS recurring_log(recurring_id TEXT NOT NULL,nest_id TEXT NOT NULL,occ_date TEXT NOT NULL,entry_id TEXT,PRIMARY KEY(recurring_id,occ_date))`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS goals(id TEXT PRIMARY KEY,nest_id TEXT NOT NULL,name TEXT NOT NULL,emoji TEXT DEFAULT '🍯',target_cents INTEGER NOT NULL,saved_cents INTEGER DEFAULT 0,created_at INTEGER,updated_at INTEGER)`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS jar_moves(id TEXT PRIMARY KEY,nest_id TEXT NOT NULL,goal_id TEXT NOT NULL,member_id TEXT NOT NULL,amount_cents INTEGER NOT NULL,created_at INTEGER)`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS budgets(nest_id TEXT NOT NULL,category TEXT NOT NULL,limit_cents INTEGER NOT NULL,PRIMARY KEY(nest_id,category))`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS debts(id TEXT PRIMARY KEY,nest_id TEXT NOT NULL,name TEXT NOT NULL,start_cents INTEGER NOT NULL,paid_cents INTEGER DEFAULT 0,apr_bp INTEGER DEFAULT 0,min_cents INTEGER DEFAULT 0,created_at INTEGER,updated_at INTEGER)`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS debt_payments(id TEXT PRIMARY KEY,nest_id TEXT NOT NULL,debt_id TEXT NOT NULL,member_id TEXT NOT NULL,amount_cents INTEGER NOT NULL,date TEXT NOT NULL,entry_id TEXT,created_at INTEGER)`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS reset_tokens(token_hash TEXT PRIMARY KEY,user_id TEXT NOT NULL,expires_at INTEGER NOT NULL,used_at INTEGER,created_at INTEGER)`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS verify_tokens(token_hash TEXT PRIMARY KEY,user_id TEXT NOT NULL,expires_at INTEGER NOT NULL,used_at INTEGER,created_at INTEGER)`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS rate_limits(key TEXT PRIMARY KEY,count INTEGER NOT NULL,expires_at INTEGER NOT NULL)`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS inbox(id TEXT PRIMARY KEY,user_id TEXT NOT NULL,kind TEXT NOT NULL,data TEXT NOT NULL,read_at INTEGER,created_at INTEGER)`).run();
  const alters = [
    `ALTER TABLE users ADD COLUMN verified INTEGER DEFAULT 0`,`ALTER TABLE users ADD COLUMN xp INTEGER DEFAULT 0`,`ALTER TABLE users ADD COLUMN streak INTEGER DEFAULT 0`,`ALTER TABLE users ADD COLUMN best_streak INTEGER DEFAULT 0`,`ALTER TABLE users ADD COLUMN last_day TEXT`,`ALTER TABLE users ADD COLUMN week_key TEXT`,`ALTER TABLE users ADD COLUMN week_xp INTEGER DEFAULT 0`,`ALTER TABLE users ADD COLUMN logs INTEGER DEFAULT 0`,`ALTER TABLE users ADD COLUMN tz TEXT`,`ALTER TABLE users ADD COLUMN lang TEXT DEFAULT 'en'`,`ALTER TABLE users ADD COLUMN mail_bills INTEGER DEFAULT 1`,`ALTER TABLE users ADD COLUMN mail_streak INTEGER DEFAULT 1`,`ALTER TABLE users ADD COLUMN mail_weekly INTEGER DEFAULT 1`,`ALTER TABLE nests ADD COLUMN setup_done INTEGER DEFAULT 0`,`ALTER TABLE entries ADD COLUMN private INTEGER DEFAULT 0`
  ];
  for (const q of alters) await env.DB.prepare(q).run().catch(() => {});
  await env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_entries_nest_date ON entries(nest_id,date)`).run();
  await env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_inbox_user_created ON inbox(user_id,created_at)`).run();
}

async function handleApi(req, env, ctx) {
  const u = new URL(req.url), path = u.pathname, method = req.method;
  if (path === "/api/health") return json({ ok: true });
  await setupDb(env);

  if (path === "/api/signup" && method === "POST") {
    if (!(await rate(env, `su:${ipKey(req)}`, 8, 3600))) return err("Too many sign-ups from here. Try again in an hour.", 429);
    const b = await readJson(req), em = email(b.email), name = clean(b.name, 24), pw = String(b.password || ""), lang = LANGS.has(b.lang) ? b.lang : "en";
    if (!okEmail(em)) return err("Enter a valid email address."); if (!name) return err("Enter your name."); if (pw.length < 8) return err("Use a password with at least 8 characters.");
    if (await env.DB.prepare(`SELECT id FROM users WHERE email=?`).bind(em).first()) return err("An account with that email already exists. Log in instead.", 409);
    const id = uuid(), ph = await makePass(pw), t = now();
    await env.DB.prepare(`INSERT INTO users(id,email,name,pass_hash,pass_salt,lang,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?)`).bind(id, em, name, ph.hash, ph.salt, lang, t, t).run();
    const sess = await makeSession(id, env);
    ctx.waitUntil(sendVerify(env, id, em, name, lang).catch(() => {}));
    return json({ ok: true }, 200, { "set-cookie": cookie("hb_session", sess.token) });
  }

  if (path === "/api/login" && method === "POST") {
    const ip = ipKey(req); if (!(await rate(env, `li:${ip}`, 20, 900))) return err("Too many tries. Wait 15 minutes.", 429);
    const b = await readJson(req), em = email(b.email), pw = String(b.password || "");
    const row = await env.DB.prepare(`SELECT * FROM users WHERE email=?`).bind(em).first();
    if (!row || !(await checkPass(pw, row.pass_salt, row.pass_hash))) return err("Wrong email or password.", 401);
    const sess = await makeSession(row.id, env); return json({ ok: true }, 200, { "set-cookie": cookie("hb_session", sess.token) });
  }

  if (path === "/api/logout" && method === "POST") { await clearSession(req, env); return json({ ok: true }, 200, { "set-cookie": cookie("hb_session", "", 0) }); }

  if (path === "/api/password/forgot" && method === "POST") {
    const b = await readJson(req), em = email(b.email);
    if (!(await rate(env, `pw:${ipKey(req)}`, 5, 3600))) return err("Too many reset requests. Try again in an hour.", 429);
    const row = await env.DB.prepare(`SELECT * FROM users WHERE email=?`).bind(em).first();
    if (row) ctx.waitUntil(sendReset(env, row).catch(() => {}));
    return json({ ok: true });
  }
  if (path === "/api/password/reset" && method === "POST") {
    const b = await readJson(req), raw = String(b.token || ""), pw = String(b.password || ""); if (pw.length < 8) return err("Use a password with at least 8 characters.");
    const h = await tokenHash(raw), r = await env.DB.prepare(`SELECT * FROM reset_tokens WHERE token_hash=? AND used_at IS NULL AND expires_at>?`).bind(h, now()).first();
    if (!r) return err("This reset link has expired or was already used. Ask for a new one.", 400);
    const ph = await makePass(pw);
    await env.DB.batch([env.DB.prepare(`UPDATE users SET pass_hash=?,pass_salt=?,updated_at=? WHERE id=?`).bind(ph.hash, ph.salt, now(), r.user_id), env.DB.prepare(`UPDATE reset_tokens SET used_at=? WHERE token_hash=?`).bind(now(), h), env.DB.prepare(`DELETE FROM sessions WHERE user_id=?`).bind(r.user_id)]);
    const sess = await makeSession(r.user_id, env); return json({ ok: true }, 200, { "set-cookie": cookie("hb_session", sess.token) });
  }

  if (path === "/api/email/verify" && method === "POST") {
    const b = await readJson(req), h = await tokenHash(String(b.token || ""));
    const r = await env.DB.prepare(`SELECT * FROM verify_tokens WHERE token_hash=? AND used_at IS NULL AND expires_at>?`).bind(h, now()).first();
    if (!r) return err("This link has expired or was already used. You can send a new one from Settings.", 400);
    await env.DB.batch([env.DB.prepare(`UPDATE users SET verified=1,updated_at=? WHERE id=?`).bind(now(), r.user_id), env.DB.prepare(`UPDATE verify_tokens SET used_at=? WHERE token_hash=?`).bind(now(), h)]);
    return json({ ok: true });
  }

  const user = await auth(req, env); if (!user) return err("Please log in.", 401);

  if (path === "/api/me" && method === "GET") { const n = await userNest(env, user.id); return json({ user: safeUser(user), nest_id: n?.id || null }); }
  if (path === "/api/me" && method === "PATCH") {
    const b = await readJson(req), sets = [], vals = [];
    const fields = [["name", clean(b.name,24)], ["emoji", clean(b.emoji,8)], ["color", clean(b.color,16)], ["tz", clean(b.tz,80)]];
    for (const [k,v] of fields) if (b[k] !== undefined && v) { sets.push(`${k}=?`); vals.push(v); }
    if (b.lang !== undefined && LANGS.has(b.lang)) { sets.push(`lang=?`); vals.push(b.lang); }
    for (const [k,col] of [["mail_bills","mail_bills"],["mail_streak","mail_streak"],["mail_weekly","mail_weekly"]]) if (b[k] !== undefined) { sets.push(`${col}=?`); vals.push(b[k] ? 1 : 0); }
    if (sets.length) { sets.push(`updated_at=?`); vals.push(now(), user.id); await env.DB.prepare(`UPDATE users SET ${sets.join(",")} WHERE id=?`).bind(...vals).run(); }
    const fresh = await env.DB.prepare(`SELECT * FROM users WHERE id=?`).bind(user.id).first(); return json({ user: safeUser(fresh) });
  }

  if (path === "/api/password/change" && method === "POST") {
    const b = await readJson(req), cur = String(b.current || ""), pw = String(b.password || "");
