  if(path==="/api/inbox/read"&&method==="POST"){await env.DB.prepare(`UPDATE inbox SET read_at=? WHERE user_id=? AND read_at IS NULL`).bind(now(),user.id).run();return json({ok:true});}

  if(path==="/api/account/export"&&method==="GET"){
    const n=await userNest(env,user.id);const out={exported_at:new Date().toISOString(),user:safeUser(user),nest:null};if(n){const mems=await members(env,n.id);out.nest={...n,members:mems.map(safeMember),entries:await env.DB.prepare(`SELECT * FROM entries WHERE nest_id=? AND (private=0 OR member_id=?) ORDER BY date,id`).bind(n.id,user.id).all().then(x=>x.results),recurring:await env.DB.prepare(`SELECT * FROM recurring WHERE nest_id=?`).bind(n.id).all().then(x=>x.results),goals:await env.DB.prepare(`SELECT * FROM goals WHERE nest_id=?`).bind(n.id).all().then(x=>x.results),budgets:await env.DB.prepare(`SELECT * FROM budgets WHERE nest_id=?`).bind(n.id).all().then(x=>x.results),debts:await env.DB.prepare(`SELECT * FROM debts WHERE nest_id=?`).bind(n.id).all().then(x=>x.results),settlements:await env.DB.prepare(`SELECT * FROM settlements WHERE nest_id=?`).bind(n.id).all().then(x=>x.results)};}return new Response(JSON.stringify(out,null,2),{headers:{"content-type":"application/json; charset=utf-8","content-disposition":"attachment; filename=honeybun-data.json"}});
  }

  if(path==="/api/account/delete"&&method==="POST"){
    const b=await readJson(req);if(!(await checkPass(String(b.password||""),user.pass_salt,user.pass_hash)))return err("That password is wrong.",400);const n=await userNest(env,user.id);if(n){const cnt=await env.DB.prepare(`SELECT COUNT(*) n FROM members WHERE nest_id=?`).bind(n.id).first();if((cnt?.n||0)<=1)await deleteNest(env,n.id);else{await env.DB.prepare(`DELETE FROM entries WHERE nest_id=? AND member_id=? AND private=1`).bind(n.id,user.id).run();await env.DB.prepare(`DELETE FROM members WHERE nest_id=? AND user_id=?`).bind(n.id,user.id).run();}}
    await env.DB.batch([env.DB.prepare(`DELETE FROM sessions WHERE user_id=?`).bind(user.id),env.DB.prepare(`DELETE FROM reset_tokens WHERE user_id=?`).bind(user.id),env.DB.prepare(`DELETE FROM verify_tokens WHERE user_id=?`).bind(user.id),env.DB.prepare(`DELETE FROM inbox WHERE user_id=?`).bind(user.id),env.DB.prepare(`DELETE FROM users WHERE id=?`).bind(user.id)]);return json({ok:true},200,{"set-cookie":cookie("hb_session","",0)});
  }

  return err("Not found.",404);
}

function validateEntry(b,mems,myId){
  const type=b.type==="income"?"income":"expense",amount_cents=money(b.amount),label=clean(b.label,40),category=CATS.has(b.category)?b.category:"other",member_id=clean(b.member_id,80),date=clean(b.date,10),shared=type==="expense"&&!!b.shared&&mems.length>1?1:0,private=type==="expense"&&!shared&&member_id===myId&&!!b.private?1:0,split_mode=shared&&(SPLIT.has(b.split_mode)?b.split_mode:"equal"),sv=Number(b.split_value);if(!(amount_cents>0))return{error:"Type an amount above $0 first."};if(!mems.some(m=>m.id===member_id))return{error:"Pick who paid."};if(!/^\d{4}-\d{2}-\d{2}$/.test(date))return{error:"Pick the date."};let split_value=null;if(shared&&split_mode==="percent"){if(!(sv>=0&&sv<=100))return{error:"Enter a percent from 0 to 100."};split_value=Math.round(sv);}if(shared&&split_mode==="owed"){const c=money(sv);if(!(c>0&&c<=amount_cents))return{error:"The amount owed has to be more than $0 and no more than the total."};split_value=c;}return{type,amount_cents,label:label|| (type==="income"?"Paycheck":"Expense"),category,member_id,date,shared,private,split_mode:shared?split_mode:null,split_value};
}
