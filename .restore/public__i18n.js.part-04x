      "Use a password with at least 8 characters.": "密码至少 8 个字符。", "Too many tries. Wait 15 minutes and try again.": "尝试次数过多，请 15 分钟后再试。",
      "Too many tries. Wait 15 minutes.": "尝试次数过多，请等 15 分钟。", "Too many tries. Try again later.": "尝试次数过多，请稍后再试。",
      "Too many sign-ups from here. Try again in an hour.": "此网络注册次数过多，请一小时后再试。", "Too many reset requests. Try again in an hour.": "重置请求过多，请一小时后再试。",
      "Please log in.": "请登录。", "This reset link has expired or was already used. Ask for a new one.": "重置链接已过期或已使用，请重新申请。",
      "This link has expired or was already used. You can send a new one from Settings.": "链接已过期或已使用，可在设置中重新发送。",
      "That invite code doesn't match any budget. Check it and try again.": "邀请码无效，请检查后重试。",
      "You're already in a budget. Leave it in Settings first, then join this one.": "你已在一个预算中。请先在设置中退出，再加入这个。",
      "You're already in a budget.": "你已在一个预算中。", "This budget is full.": "该预算人数已满。", "Your current password is wrong.": "当前密码错误。", "That password is wrong.": "密码错误。",
      "Enter a name.": "请输入名字。", "Name your goal.": "请为目标命名。", "Name the debt.": "请为债务命名。", "Pick who paid.": "请选择付款人。", "Pick how often it repeats.": "请选择重复频率。",
      "Pick the next date.": "请选择下次日期。", "Enter a percent from 0 to 100.": "请输入 0 到 100 的百分比。",
      "The amount owed has to be more than $0 and no more than the total.": "欠款须大于 $0 且不超过总额。", "You can't take out more than you've saved for this goal.": "取出金额不能超过该目标已存的钱。",
      "Enter an interest rate from 0 to 100%.": "请输入 0 到 100% 的利率。", "Enter a valid minimum payment.": "请输入有效的最低还款额。",
      "Couldn't send the email. Try again in a minute.": "邮件发送失败，请一分钟后再试。", "Emails aren't set up yet. Ask the site owner to add the email key.": "邮件功能尚未设置。",
      "We already sent a few. Check your inbox and spam, or try again in an hour.": "已经发过几封了。请查看收件箱和垃圾邮件，或一小时后再试。", "Enter the amount that was paid.": "请输入已付金额。",
    },
    patterns: [
      [/^(−?\$[\d,.]+) spent this month$/, "本月支出 $1"],
      [/^(\d+) days$/, "$1 天"], [/^(\d+) carrots$/, "$1 根胡萝卜"], [/^of (\$[\d,.]+)$/, "目标 $1"], [/^(.+)'s balance in$/, "$1 的余额 ·"],
      [/^Hi (.+)!$/, "$1，你好！"], [/^Hi, (.+)!$/, "$1，你好！"],
      [/^(\d+)% of this month is still ours\.$/, "本月还剩 $1%。"], [/^(\d+)% of this month is still yours\.$/, "本月还剩 $1%。"],
      [/^Overdue, was due (.+)$/, "已逾期，原定 $1"], [/^Due (.+)$/, "$1 到期"], [/^(.+) gets paid (.+)$/, "$1 于 $2 发薪"],
      [/^Left after bills (.+)$/, "付完账单剩 $1"], [/^Over by (.+)$/, "超支 $1"],
      [new RegExp(`^${M} left of ${M}$`), "剩 $1 / 共 $2"], [new RegExp(`^${M} left$`), "剩 $1"], [new RegExp(`^${M} paid so far$`), "已还 $1"],
      [new RegExp(`^${M} of ${M} saved$`), "已存 $1 / $2"], [new RegExp(`^${M} of ${M}( · reached ♡)?$`), (_, a, b, r) => `${a} / ${b}${r ? " · 已达成 ♡" : ""}`],
      [/^Lv (\d+) · 🐾 (\d+)$/, "$1 级 · 🐾 $2"], [/^Lv (\d+) · (.+)$/, (_, l, t) => `${l} 级 · ${T(t)}`],
      [/^Level (\d+) · (.+)$/, (_, l, t) => `${l} 级 · ${T(t)}`], [/^Level (\d+)$/, "$1 级"], [/^(\d+) to level (\d+)$/, "距 $2 级还差 $1"],
      [/^🐾 (\d+)-day streak$/, "🐾 连续 $1 天"], [/^Best (\d+)$/, "最佳 $1"], [/^(\d+) of (\d+)$/, "$1 / $2"],
      [/^Your bunny unlocked (.+)!$/, (_, x) => `小兔子解锁了${T(x)}！`], [/^(.+): unlocked ♡$/, (_, x) => `${T(x)}：已解锁 ♡`],
      [/^(.+?)\s+\+(\d+) 🥕$/, (_, m, n) => `${T(m)}  +${n} 🥕`], [/^🐾 (\d+)-day hop streak!$/, "🐾 已连续记录 $1 天！"],
      [/^🍯 You reached (.+)!$/, "🍯 你达成了「$1」！"], [/^🎉 (.+) is paid off!$/, "🎉 「$1」已还清！"],
      [/^Synced (\d+) offline entr(y|ies)$/, "已同步 $1 条离线记录"], [/^(\d+) found · net (.+)$/, "找到 $1 条 · 净额 $2"],
      [/^Only (.+)'s money\.$/, "只显示 $1 的收支。"], [/^Nothing yet for (.+)\. Tap \+ to add something\.$/, "$1 还没有记录。点 + 记一笔。"],
      [/^Nothing logged for (.+)\.$/, "$1 没有记录。"], [/^Nothing due before payday ♡$/, "发薪前没有待付 ♡"], [/^Nothing due soon ♡$/, "近期没有待付 ♡"],
      [/^Signed in as (.+)$/, "已登录：$1"], [/^(.+) paid (.+) back\.$/, "$1 已还给 $2。"], [/^(.+) owes \$$/, "$1 欠 $"], [/^Everyone else owe \$$/, "其他人共欠 $"],
      [/^(.+) covers$/, "$1 承担"], [/^(.+) covers (\d+)%\.$/, "$1 承担 $2%。"], [/^(.+) cover (\d+)%, split between them\.$/, "$1 承担 $2%，由他们平分。"],
      [/^Use this when (.+) paid and just needs part of it back\.$/, "适用于 $1 已付款、只需要收回一部分的情况。"],
      [/^(\d+) paydays? and (\d+) bills? added\. You can change them anytime in Plan\.$/, "已添加 $1 个发薪日和 $2 个账单，可随时在「计划」中修改。"],
      [/^\+(.+) in$/, "收入 +$1"], [/^(.+) out$/, "支出 $1"],
      [/^Deleted (.+)$/, (_, x) => `已删除 ${T(x)}`], [/^Delete (.+)\?$/, "删除「$1」？"], [/^Delete (.+)$/, "删除 $1"], [/^Added to (.+)$/, "已存入 $1"],
      [/^(.+) marked paid$/, (_, x) => `${T(x)} 已标记为已付`], [/^(.+)'s paycheck$/, "$1 的工资"], [/^(.+) added$/, (_, x) => `已添加 ${T(x)}`],
      [/^added (.+)$/, "存入 $1"], [/^took out (.+)$/, "取出 $1"], [/^paid (.+) on (.+), (.+)$/, "为 $2 还款 $1，$3"],
      [/^(.+): earned (.+), paid (.+)\. Tap to see only theirs\.$/, "$1：收入 $2，支出 $3。点按只看 TA 的。"],
      [/^(.+): earned (.+)$/, "$1：收入 $2"], [/^(.+): spent (.+)$/, "$1：支出 $2"], [/^(.+) owes (.+)$/, "$1 欠 $2"],
      [/^(\p{Extended_Pictographic}\S*) (.+)$/u, (all, e, rest) => { const t = T(rest); return t === rest ? all : `${e} ${t}`; }],
    ],
    subs: [
      [/, personal, private$/, "，个人，私密"], [/, personal$/, "，个人"], [/, split evenly$/, "，平均分摊"],
      [/, split (\d+)\/(\d+)$/, "，按 $1/$2 分摊"], [/, split, (.+) covers (\d+)%$/, "，分摊，$1 承担 $2%"], [/ others owe /, " 其他人欠 "], [/ owes (?=\$)/, " 欠 "],
      [/^Every month/, "每月"], [/^Every 2 weeks/, "每两周"], [/^Every week/, "每周"], [/, next /, "，下次 "], [/, split$/, "，分摊"],
      [/ · Due$/, " · 待付"], [/ · Overdue$/, " · 已逾期"], [/ · Expected$/, " · 预计"], [/ · Done ✓$/, " · 已完成 ✓"],
      [/% APR · min /, "% 年利率 · 最低 "], [/ · paid off ~/, " · 约还清于 "], [/ \(you\)$/, "（你）"],
    ],
  };

  return { es, zh };
})();
