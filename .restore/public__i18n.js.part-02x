      "Couldn't send the email. Try again in a minute.": "No se pudo enviar el correo. Intenta en un minuto.",
      "Emails aren't set up yet. Ask the site owner to add the email key.": "Los correos aún no están configurados.",
      "We already sent a few. Check your inbox and spam, or try again in an hour.": "Ya enviamos algunos. Revisa tu bandeja y spam, o intenta en una hora.",
      "Enter the amount that was paid.": "Escribe el monto que se pagó.",
    },
    patterns: [
      [/^(−?\$[\d,.]+) spent this month$/, "$1 gastado este mes"],
      [/^(\d+) days$/, "$1 días"], [/^(\d+) carrots$/, "$1 zanahorias"], [/^of (\$[\d,.]+)$/, "de $1"], [/^(.+)'s balance in$/, "Saldo de $1 en"],
      [/^Hi (.+)!$/, "¡Hola, $1!"], [/^Hi, (.+)!$/, "¡Hola, $1!"],
      [/^(\d+)% of this month is still ours\.$/, "Todavía nos queda el $1% del mes."], [/^(\d+)% of this month is still yours\.$/, "Todavía te queda el $1% del mes."],
      [/^Overdue, was due (.+)$/, "Vencido, era el $1"], [/^Due (.+)$/, "Vence $1"], [/^(.+) gets paid (.+)$/, "$1 cobra el $2"],
      [/^Left after bills (.+)$/, "Queda después de facturas $1"], [/^Over by (.+)$/, "Te pasaste por $1"],
      [new RegExp(`^${M} left of ${M}$`), "Quedan $1 de $2"], [new RegExp(`^${M} left$`), "Quedan $1"], [new RegExp(`^${M} paid so far$`), "$1 pagados hasta ahora"],
      [new RegExp(`^${M} of ${M} saved$`), "$1 de $2 ahorrados"], [new RegExp(`^${M} of ${M}( · reached ♡)?$`), (_, a, b, r) => `${a} de ${b}${r ? " · ¡lograda! ♡" : ""}`],
      [/^Lv (\d+) · 🐾 (\d+)$/, "Nv $1 · 🐾 $2"], [/^Lv (\d+) · (.+)$/, (_, l, t) => `Nv ${l} · ${T(t)}`],
      [/^Level (\d+) · (.+)$/, (_, l, t) => `Nivel ${l} · ${T(t)}`], [/^Level (\d+)$/, "Nivel $1"], [/^(\d+) to level (\d+)$/, "$1 para el nivel $2"],
      [/^🐾 (\d+)-day streak$/, "🐾 Racha de $1 días"], [/^Best (\d+)$/, "Mejor $1"], [/^(\d+) of (\d+)$/, "$1 de $2"],
      [/^Your bunny unlocked (.+)!$/, (_, x) => `¡Tu conejito desbloqueó ${T(x)}!`], [/^(.+): unlocked ♡$/, (_, x) => `${T(x)}: ¡desbloqueada! ♡`],
      [/^(.+?)\s+\+(\d+) 🥕$/, (_, m, n) => `${T(m)}  +${n} 🥕`], [/^🐾 (\d+)-day hop streak!$/, "🐾 ¡Racha de $1 días!"],
      [/^🍯 You reached (.+)!$/, "🍯 ¡Lograste $1!"], [/^🎉 (.+) is paid off!$/, "🎉 ¡$1 está pagada!"],
      [/^Synced (\d+) offline entr(y|ies)$/, "Se sincronizaron $1 registros"], [/^(\d+) found · net (.+)$/, "$1 encontrados · neto $2"],
      [/^Only (.+)'s money\.$/, "Solo el dinero de $1."], [/^Nothing yet for (.+)\. Tap \+ to add something\.$/, "Aún no hay nada en $1. Toca + para agregar algo."],
      [/^Nothing logged for (.+)\.$/, "Nada registrado en $1."], [/^Nothing due before payday ♡$/, "Nada vence antes del pago ♡"], [/^Nothing due soon ♡$/, "Nada vence pronto ♡"],
      [/^Signed in as (.+)$/, "Sesión iniciada como $1"], [/^(.+) paid (.+) back\.$/, "$1 le devolvió a $2."], [/^(.+) owes \$$/, "$1 debe $"], [/^Everyone else owe \$$/, "Los demás deben $"],
      [/^(.+) covers$/, "$1 cubre"], [/^(.+) covers (\d+)%\.$/, "$1 cubre el $2%."], [/^(.+) cover (\d+)%, split between them\.$/, "$1 cubren el $2%, dividido entre ellos."],
      [/^Use this when (.+) paid and just needs part of it back\.$/, "Úsalo cuando $1 pagó y solo necesita que le devuelvan una parte."],
      [/^(\d+) paydays? and (\d+) bills? added\. You can change them anytime in Plan\.$/, "$1 pago(s) y $2 factura(s) agregados. Puedes cambiarlos cuando quieras en Plan."],
      [/^\+(.+) in$/, "+$1 entra"], [/^(.+) out$/, "$1 sale"],
      [/^Deleted (.+)$/, (_, x) => `Eliminado: ${T(x)}`], [/^Delete (.+)\?$/, "¿Eliminar $1?"], [/^Delete (.+)$/, "Eliminar $1"], [/^Added to (.+)$/, "Agregado a $1"],
      [/^(.+) marked paid$/, (_, x) => `${T(x)} marcado como pagado`], [/^(.+)'s paycheck$/, "Pago de $1"], [/^(.+) added$/, (_, x) => `${T(x)} agregado`],
      [/^added (.+)$/, "agregó $1"], [/^took out (.+)$/, "sacó $1"], [/^paid (.+) on (.+), (.+)$/, "pagó $1 en $2, $3"],
      [/^(.+): earned (.+), paid (.+)\. Tap to see only theirs\.$/, "$1: ganó $2, pagó $3. Toca para ver solo lo suyo."],
      [/^(.+): earned (.+)$/, "$1: ganado $2"], [/^(.+): spent (.+)$/, "$1: gastado $2"], [/^(.+) owes (.+)$/, "$1 le debe a $2"],
      [/^(\p{Extended_Pictographic}\S*) (.+)$/u, (all, e, rest) => { const t = T(rest); return t === rest ? all : `${e} ${t}`; }],
    ],
    subs: [
      [/, personal, private$/, ", personal, privado"], [/, personal$/, ", personal"], [/, split evenly$/, ", dividido igual"],
      [/, split (\d+)\/(\d+)$/, ", dividido $1/$2"], [/, split, (.+) covers (\d+)%$/, ", dividido, $1 cubre $2%"], [/ others owe /, " los demás deben "], [/ owes (?=\$)/, " debe "],
      [/^Every month/, "Cada mes"], [/^Every 2 weeks/, "Cada 2 semanas"], [/^Every week/, "Cada semana"], [/, next /, ", próximo "], [/, split$/, ", dividido"],
      [/ · Due$/, " · Vence"], [/ · Overdue$/, " · Vencido"], [/ · Expected$/, " · Esperado"], [/ · Done ✓$/, " · Hecho ✓"],
      [/% APR · min /, "% TAE · mín. "], [/ · paid off ~/, " · liquidada ~"], [/ \(you\)$/, " (tú)"],
    ],
  };

