{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Honeybun",
  "version": "1.0.5",
  "identifier": "me.honeybun.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Honeybun",
    "copyright": "© 2026 Honeybun",
    "shortDescription": "A cute little budget",
    "longDescription": "Honeybun is a simple, cute budget for you, your partner, or your whole family.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
