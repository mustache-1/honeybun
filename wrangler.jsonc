{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "honeybun",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "APP_URL": "https://honeybun.me",
    "MAIL_FROM": "Honeybun <hello@honeybun.me>"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "honeybun",
      "database_id": "f32e430a-fa1e-45b2-827f-32b3c6c80e64"
    }
  ],

  "triggers": { "crons": ["0 * * * *"] },

  "routes": [
    { "pattern": "honeybun.me", "custom_domain": true }
  ]
}
